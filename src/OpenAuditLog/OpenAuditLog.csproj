<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Version>1.0.3</Version>
    <TargetFrameworks>netstandard2.1;net462;net8.0;net10.0</TargetFrameworks>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <Authors>Joel Christner</Authors>
    <Company>Joel Christner</Company>
    <PackageProjectUrl>https://github.com/jchristn/OpenAuditLog</PackageProjectUrl>
    <RepositoryUrl>https://github.com/jchristn/OpenAuditLog</RepositoryUrl>
    <RepositoryType>github</RepositoryType>
    <PackageTags>audit log event emitter logger</PackageTags>
    <Description>Simple C# event library providing event persistence and allowing you to write your own emitters</Description>
    <Copyright>(c)2026 Joel Christner</Copyright>
    <PackageReleaseNotes>Dependency updates (WatsonORM 3.x, System.Text.Json 10.x); resolves the high-severity SQLite/SQLitePCLRaw advisory GHSA-2m69-gcr7-jv3q by pinning a patched e_sqlite3 bundle. No public API changes. Publishes a symbol package (.snupkg).</PackageReleaseNotes>
    <PackageLicenseFile>LICENSE.md</PackageLicenseFile>
    <PackageIcon>logo.png</PackageIcon>
	  <DocumentationFile>OpenAuditLog.xml</DocumentationFile>
	  <Title>OpenAuditLog</Title>
	  <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Text.Json" Version="10.0.11" />
    <PackageReference Include="WatsonORM.Sqlite" Version="3.0.14" />
    <!-- Override the transitive SQLitePCLRaw (2.1.10) pulled in via WatsonORM/Microsoft.Data.Sqlite,
         which is flagged by GHSA-2m69-gcr7-jv3q (SQLite < 3.50.2).  2.1.13 bundles a patched SQLite. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.13" />
  </ItemGroup>

  <ItemGroup>
    <None Update="assets\logo.ico">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="assets\logo.png">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="LICENSE.md">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Include="..\..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="assets\logo.png">
      <Pack>True</Pack>
      <PackagePath></PackagePath>
    </None>
    <None Include="LICENSE.md">
      <Pack>True</Pack>
      <PackagePath></PackagePath>
    </None>
  </ItemGroup>

</Project>
